# Every environment variable Lens reads, names only. Copy to .env.local and fill in.
# Defaults live in src/lib/env.ts; tests/unit/env.test.ts keeps this file in sync with it.
# VERCEL_ENV is set by Vercel and isn't listed.

# Meta Model API (https://dev.meta.ai). Required for any model call.
META_API_KEY=
# Optional: defaults to https://api.meta.ai/v1
META_API_BASE_URL=
# Optional: defaults to muse-spark-1.3 (Standard mode)
MUSE_SPARK_MODEL=
# Optional: defaults to sam-3.1
SAM_MODEL=

# Global brakes on model spend per UTC day, in USD, behind the per-identity limits
# (each Tomorrow user 30 calls and $0.50 a day; each public visitor 25 calls and $0.40).
# Public demo traffic; defaults to DAILY_SPEND_CAP_USD if set, else 5.
PUBLIC_DAILY_CAP_USD=
# Tomorrow's users together. Defaults to 20.
TOMORROW_DAILY_CAP_USD=
# Older name for PUBLIC_DAILY_CAP_USD, read only when that isn't set.
DAILY_SPEND_CAP_USD=
# Shared counters for the limits. Required when deployed on Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: defaults to https://bettertmrw.app/api/lens/import (docs/IMPORT_CONTRACT.md)
TOMORROW_IMPORT_URL=

# Shared with Tomorrow for POST /api/rebuild and /api/extract (docs/REBUILD_CONTRACT.md,
# docs/EXTRACT_CONTRACT.md); also signs review links. At least 32 characters, e.g. `openssl rand -hex 32`.
# Unset: those routes answer 503.
LENS_REBUILD_SECRET=
# The owner's key (Secret). Visit /owner?key=<it> once to set a signed cookie that skips the per-visitor and
# per-address limits; the public brake still counts and every call is logged. At least 24 characters,
# e.g. `openssl rand -hex 24`. Unset: there's no owner.
OWNER_KEY=
# Optional: defaults to https://tmrw-lens.vercel.app (where review links point)
LENS_PUBLIC_URL=

# Every environment variable Lens reads, names only. Copy to .env.local and fill in.
# Defaults live in src/lib/env.ts; tests/unit/env.test.ts keeps this file in sync with it.
# VERCEL_ENV is set by Vercel and isn't listed.

# Meta Model API (https://dev.meta.ai). Required for any model call.
META_API_KEY=
# Optional: defaults to https://api.meta.ai/v1
META_API_BASE_URL=
# Optional: defaults to muse-spark-1.3 (Standard mode)
MUSE_SPARK_MODEL=
# Optional: defaults to sam-3.1
SAM_MODEL=

# Hard cap on model spend per UTC day, in USD, across all visitors. Defaults to 5.
DAILY_SPEND_CAP_USD=
# Shared counter for the cap and rate limits. Required when deployed on Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

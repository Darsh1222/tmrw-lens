{
  "name": "tmrw-lens",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "node scripts/copy-pdfjs.mjs && next dev",
    "build": "node scripts/copy-pdfjs.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:env": "node scripts/check-env-files.mjs",
    "check:secrets": "gitleaks git --redact --no-banner .",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "smoke": "tsx --env-file=.env.local scripts/smoke.ts",
    "eval": "tsx scripts/eval.ts",
    "eval:live": "tsx --env-file=.env.local scripts/eval.ts --live",
    "eval:real": "tsx --env-file=.env.local scripts/eval.ts --real",
    "sample": "tsx scripts/make-sample.ts"
  },
  "dependencies": {
    "@meta-sam/parser": "0.1.0",
    "@napi-rs/canvas": "^1.0.13",
    "luxon": "^3.7.2",
    "next": "16.4.3",
    "pdfjs-dist": "^6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
